# Copiare in .env e compilare. Generare le chiavi con: python manage.py fasas_genkey
# Ogni segreto si può leggere da un file invece che da qui: NOME_FILE=/percorso (es. DJANGO_SECRET_KEY_FILE),
# oppure dalle credenziali di systemd (LoadCredential). Vedi docs/SICUREZZA.md, «Custodia delle chiavi».
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=fasas.esempio.it
DJANGO_CSRF_TRUSTED_ORIGINS=https://fasas.esempio.it

# Database PostgreSQL (Supabase: Project Settings > Database > Connection string, modalità "Session")
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_SSL_REQUIRE=1
DATABASE_CONN_MAX_AGE=60

# Cifratura file (una o più chiavi Fernet separate da virgola: la prima cifra)
FASAS_ENCRYPTION_KEYS=
# Cifratura backup (32 byte base64). Conservarla anche FUORI dal server.
FASAS_BACKUP_KEY=
FASAS_BACKUP_DIR=/var/lib/fasas/backups
FASAS_MEDIA_ROOT=/var/lib/fasas/media

# Storage S3 opzionale per i file cifrati (richiede django-storages[s3])
# FASAS_S3_BUCKET=
# FASAS_S3_ENDPOINT_URL=
# FASAS_S3_REGION=

# Reti autorizzate (CIDR separati da virgola). Vuoto = nessuna restrizione applicativa.
FASAS_ALLOWED_NETWORKS=
# Numero di reverse proxy fidati davanti all'applicazione (nginx = 1)
FASAS_TRUSTED_PROXY_COUNT=1
FASAS_LOGIN_MAX_FAILURES=5
FASAS_LOGIN_LOCKOUT_MINUTES=15
# Verifica in due passaggi: ruoli obbligati (vuoto = facoltativa) e reti della struttura (da fuori serve a tutti)
FASAS_2FA_REQUIRED_ROLES=admin,coordinator,doctor
FASAS_2FA_TRUSTED_NETWORKS=
FASAS_2FA_ISSUER=FASAS

# Copia dei backup fuori sede (object storage S3 in UE con Object Lock) – docs/BACKUP.md
FASAS_OFFSITE_ENDPOINT=
FASAS_OFFSITE_REGION=
FASAS_OFFSITE_BUCKET=
FASAS_OFFSITE_ACCESS_KEY=
FASAS_OFFSITE_SECRET_KEY=
FASAS_OFFSITE_LOCK_DAYS=30
FASAS_OFFSITE_KEEP_DAILY=30
FASAS_OFFSITE_KEEP_MONTHLY=12
# Database vuoto per la prova di ripristino trimestrale dei backup PostgreSQL
FASAS_RESTORE_TEST_DATABASE_URL=

# Monitoraggio (docs/MONITORAGGIO.md): token per il dettaglio di /salute/, spazio minimo su disco
FASAS_HEALTH_TOKEN=
FASAS_HEALTH_MIN_FREE_GB=5

# Protocolli automatici attivi solo dopo la validazione del medico (docs/DISPOSITIVO_MEDICO.md)
FASAS_PROTOCOLS_REQUIRE_VALIDATION=1
# Punti di controllo notturni dell'audit con la marca temporale della TSA qui sotto
FASAS_AUDIT_TIMESTAMP=1

# Firma digitale: marca temporale (TSA RFC 3161) e livello PAdES
FASAS_SIGNATURE_TSA_URL=
FASAS_SIGNATURE_TSA_USER=
FASAS_SIGNATURE_TSA_PASSWORD=
# B-B, B-T, B-LT, B-LTA (vuoto: B-T se è configurata la TSA)
FASAS_SIGNATURE_LEVEL=
FASAS_SIGNATURE_TRUST_ROOTS=
# Firma remota qualificata (API CSC del prestatore): vedi docs/FIRMA_DIGITALE.md
FASAS_CSC_SERVICE_URL=
FASAS_CSC_PROVIDER_NAME=
FASAS_CSC_AUTH=basic
FASAS_CSC_OAUTH_TOKEN_URL=
FASAS_CSC_CLIENT_ID=
FASAS_CSC_CLIENT_SECRET=

# Firma con CIE: accettazione delle condizioni firmata con la CIE prima della prima firma (docs/FIRMA_CIE.md)
FASAS_FEA_REQUIRE_ACCEPTANCE=1
# File di testo con le condizioni approvate dal legale (vuoto = bozza fornita con il FASAS)
FASAS_FEA_TERMS_FILE=
FASAS_FEA_RETENTION_YEARS=20

# Notifiche push: generare la chiave con «python manage.py fasas_vapid_keys»
FASAS_VAPID_PRIVATE_KEY=
FASAS_VAPID_SUBJECT=mailto:amministrazione@vostra-struttura.it
# 1 = mostra titolo e messaggio completi sul telefono (default: solo il tipo di avviso, senza nomi)
FASAS_PUSH_SHOW_DETAILS=0

# Email notifiche (facoltativa)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=fasas@esempio.it

# Attività pianificate
CELERY_BROKER_URL=redis://localhost:6379/0

# Solo per docker compose (docs/CONTAINER.md)
POSTGRES_PASSWORD=
FASAS_DOMAIN=fasas.esempio.it
