# Versione cloud del FASAS (docs/CLOUD.md): variabili da inserire nel servizio di hosting (es. Render), NON in un
# file del repository. Le chiavi: python manage.py fasas_genkey (oppure il comando del passo 1 di docs/CLOUD.md).
# Ogni chiave va copiata anche nella busta di custodia: senza, documenti e backup non sono recuperabili.

FASAS_CLOUD=1
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
FASAS_ENCRYPTION_KEYS=
FASAS_BACKUP_KEY=

# Dominio del FASAS (senza https://). Il nome assegnato da Render (…onrender.com) è aggiunto da solo.
FASAS_DOMAIN=fasas.esempio.it

# Database Supabase: stringa «Session pooler» (porta 5432) da Connect › Session pooler, con la password del database
DATABASE_URL=postgresql://postgres.RIFERIMENTO:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_SSL_REQUIRE=1

# File cifrati su Supabase Storage (bucket privato) con le chiavi S3 di Storage › Settings › S3 Connection.
# Non è la chiave «service_role»: quella non serve al FASAS e non va usata.
FASAS_S3_BUCKET=fasas-documenti
FASAS_S3_ENDPOINT_URL=https://RIFERIMENTO.storage.supabase.co/storage/v1/s3
FASAS_S3_REGION=eu-central-1
FASAS_S3_ACCESS_KEY=
FASAS_S3_SECRET_KEY=

# Copia fuori sede dei backup cifrati (il disco del container è temporaneo). Due possibilità, docs/CLOUD.md passo 5:
# A) secondo bucket privato in Supabase (senza blocco delle modifiche: Supabase Storage non lo offre)
FASAS_OFFSITE_ENDPOINT=https://RIFERIMENTO.storage.supabase.co/storage/v1/s3
FASAS_OFFSITE_REGION=eu-central-1
FASAS_OFFSITE_BUCKET=fasas-backup
FASAS_OFFSITE_ACCESS_KEY=
FASAS_OFFSITE_SECRET_KEY=
FASAS_OFFSITE_LOCK_DAYS=0
# B) object storage con Object Lock in UE (es. Backblaze B2, docs/BACKUP.md): endpoint, bucket e chiavi di quel
#    servizio e FASAS_OFFSITE_LOCK_DAYS=30

# Primo amministratore, creato al primo avvio se non ce n'è nessuno. Dopo il primo accesso togliere la password.
FASAS_ADMIN_USERNAME=amministratore
FASAS_ADMIN_PASSWORD=

# Controllo dall'esterno: dettaglio di /salute/ solo con questo token
FASAS_HEALTH_TOKEN=

# Memoria contenuta (istanze da 512 MB): un processo con più thread
GUNICORN_WORKERS=1
GUNICORN_THREADS=8

# Facoltative: notifiche push (python manage.py fasas_vapid_keys), email
# FASAS_VAPID_PRIVATE_KEY=
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
