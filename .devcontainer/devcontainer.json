{
  // Ambiente di prova per GitHub Codespaces: il sistema gira nel cloud e si apre nel browser.
  // Solo dati dimostrativi: non inserire dati reali di ospiti.
  "name": "FASAS Digitale – prova",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "FASAS", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
